# Optional local overrides. Copy to .env in the directory you run the CLI from.
# Exported environment variables override these values.
RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO
# Relative to the current working directory; downloaded models use data/models.
RAG_DATA_DIR=./data
# Local Compose database only. Keep real credentials out of version control.
RAG_DATABASE_URL=postgresql+psycopg://rag:rag_local@127.0.0.1:55432/rag
# Optional Compose host-port override; update RAG_DATABASE_URL to match.
# RAG_POSTGRES_PORT=55432

# Local vector index. Model weights are downloaded on first use unless offline mode is enabled.
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_COLLECTION_PREFIX=rag_dense
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RAG_EMBEDDING_BATCH_SIZE=8
RAG_EMBEDDING_THREADS=4
RAG_MODEL_LOCAL_FILES_ONLY=false
# RAG_QDRANT_API_KEY=...

# Optional --rerank, same model dependencies as embeddings.
RAG_RERANKING_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_RERANKING_REVISION=1427fd652930e4ba29e8149678df786c240d8825
RAG_RERANKING_BATCH_SIZE=4
RAG_RERANKING_THREADS=4
