# Optional local overrides. Copy to .env in the directory you run the CLI from.
# Exported environment variables override these values.
RAG_ENVIRONMENT=local
RAG_LOG_LEVEL=INFO
# Relative to the current working directory; downloaded models use data/models.
RAG_DATA_DIR=./data
# Local Compose database only. Keep real credentials out of version control.
RAG_DATABASE_URL=postgresql+psycopg://rag:rag_local@127.0.0.1:55432/rag
# Optional Compose host-port override; update RAG_DATABASE_URL to match.
# RAG_POSTGRES_PORT=55432

# Local vector index. Model weights are downloaded on first use unless offline mode is enabled.
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_COLLECTION_PREFIX=rag_dense
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RAG_EMBEDDING_BATCH_SIZE=8
RAG_EMBEDDING_THREADS=4
RAG_MODEL_LOCAL_FILES_ONLY=false
# RAG_QDRANT_API_KEY=...

# Optional --rerank, same model dependencies as embeddings.
RAG_RERANKING_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RAG_RERANKING_REVISION=1427fd652930e4ba29e8149678df786c240d8825
RAG_RERANKING_BATCH_SIZE=4
RAG_RERANKING_THREADS=4

# Basic RAG: ask defaults to --llm fake (no generation server needed).
# For --llm compatible, use the /v1 root and an explicit served model name.
RAG_LLM_BASE_URL=http://127.0.0.1:8000/v1
# RAG_LLM_MODEL=your-served-model
# RAG_LLM_API_KEY=...
RAG_LLM_TIMEOUT_SECONDS=60
# UTF-8 serialized-message bytes, NOT tokenizer tokens or model context length.
RAG_LLM_MAX_PROMPT_BYTES=24000
RAG_LLM_MAX_TOKENS=512

# Optional provider-specific reasoning control; omit to use server default.
# Verified on Rus-GPT Qwen3.6; other servers may reject or ignore it.
# RAG_LLM_REASONING_ENABLED=false

# Stage 7 HTTP API. Explicitly select compatible to use the configured LLM/key.
RAG_API_LLM_PROVIDER=fake
RAG_API_RETRIEVAL_MODE=bm25
RAG_API_RERANK=false
RAG_API_CANDIDATE_K=20
RAG_API_MAX_CONCURRENT_REQUESTS=8
RAG_API_REQUEST_TIMEOUT_SECONDS=180
RAG_API_MAX_BODY_BYTES=2097152

# Stage 8: /agent uses the same explicitly selected API LLM provider.
RAG_AGENT_MAX_MODEL_CALLS=6
RAG_AGENT_MAX_TOOL_CALLS=8
# UTF-8 bytes of messages + tool schemas, not serving-model tokens.
RAG_AGENT_MAX_PROMPT_BYTES=48000
RAG_AGENT_MAX_OBSERVATION_BYTES=12000
